{
  "name": "pipes",
  "version": "0.1.0",
  "description": "Watch GitHub Actions and GitLab CI/CD pipeline status across the repos you care about. Loud when main breaks.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "security-audit": "pnpm audit --audit-level=moderate",
    "icons": "node scripts/generate-icons.mjs",
    "zip": "cd dist && zip -r ../pipes.zip . -x '*.DS_Store'",
    "prepare": "husky"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild"
    ],
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mw96-cpmx-2vgc"
      ]
    }
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.4.0",
    "@eslint/compat": "2.1.0",
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/chrome": "0.1.42",
    "eslint": "10.4.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-security": "4.0.0",
    "eslint-plugin-svelte": "3.18.0",
    "globals": "17.6.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.7",
    "prettier": "3.8.3",
    "prettier-plugin-svelte": "3.5.2",
    "sharp": "0.34.5",
    "svelte": "5.56.2",
    "svelte-check": "4.6.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.0",
    "vite": "6.4.3",
    "vitest": "4.1.8"
  },
  "dependencies": {
    "@lucide/svelte": "1.17.0"
  }
}
