{
  "name": "pipes",
  "version": "1.5.0",
  "description": "Watch GitHub Actions and GitLab CI/CD pipeline status across the repos you care about.",
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "github-actions",
    "gitlab-ci",
    "ci-cd",
    "pipelines",
    "svelte"
  ],
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Ben Chidgey <ben@feedmypixel.com>",
  "homepage": "https://github.com/feedmypixel/pipes#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feedmypixel/pipes.git"
  },
  "bugs": {
    "url": "https://github.com/feedmypixel/pipes/issues"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:firefox": "TARGET=firefox vite build",
    "build:all": "pnpm build && pnpm build:firefox",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint . && stylelint \"src/**/*.css\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "security-audit": "pnpm audit --audit-level=moderate",
    "icons": "node scripts/generate-icons.mjs",
    "capture": "node scripts/capture-screenshots.mjs",
    "frame": "node scripts/frame-store.mjs",
    "release": "commit-and-tag-version",
    "zip": "cd dist-chrome && zip -r ../pipes-chrome.zip . -x '*.DS_Store'",
    "zip:firefox": "cd dist-firefox && zip -r ../pipes-firefox.zip . -x '*.DS_Store'",
    "prepare": "husky",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.7.1",
    "@eslint/compat": "2.1.0",
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@tsconfig/svelte": "5.0.8",
    "@types/chrome": "0.2.2",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "commit-and-tag-version": "12.7.3",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-security": "4.0.1",
    "eslint-plugin-svelte": "3.22.0",
    "globals": "17.7.0",
    "husky": "9.1.7",
    "lint-staged": "17.2.0",
    "playwright": "1.62.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "sharp": "0.35.3",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "svelte": "5.56.9",
    "svelte-check": "4.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "vitest-browser-svelte": "2.1.1",
    "web-ext": "10.6.0"
  },
  "dependencies": {
    "@lucide/svelte": "1.26.0",
    "pino": "10.3.1"
  }
}
